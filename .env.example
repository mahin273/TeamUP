# Server Configuration
PORT=3000

# Database (Shared Postgres connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamup?schema=public"

# Auth & Security (Backend Dev 1)
JWT_SECRET="super_secret_jwt_access_key_teamup_2026"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_teamup_2026"

# GitHub OAuth Integration (Backend Dev 1)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# AI Idea Generator (Backend Dev 1)
LLM_API_KEY="your_llm_api_key"

# Push Notifications (Backend Dev 1)
EXPO_PUSH_TOKEN_ENDPOINT="https://exp.host/--/api/v2/push/send"

# File Storage (Backend Dev 2)
S3_BUCKET="teamup-storage"
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"

# Real-time WebSocket (Backend Dev 2)
WEBSOCKET_CORS_ORIGIN="*"
